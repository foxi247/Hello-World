# Mistral AI API Key
# Get yours at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Model (recommended: mistral-large-latest)
MISTRAL_MODEL=mistral-large-latest

# Server port
PORT=3001

# How often (in seconds) the AI thinks / picks new intent
AI_THINK_INTERVAL=20

# How often (in seconds) the AI generates a thought
AI_THOUGHT_INTERVAL=15
